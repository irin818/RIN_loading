  "replacementInstructions": {
    "currentMode": "state-images",
    "safeDefaultImage": "assets/body/rin_default.png",
    "addStateImage": "Add a PNG/WebP/SVG under assets/body/ and set states.<state>.image to that path.",
    "addLayeredParts": "Switch assetMode to layered-parts and add layer entries with anchored, aligned transparent files.",
    "doNotUse": [
      "public/live2d",
      "old Cubism texture atlas",
      "moc3/model3 runtime files"
    ]
  },
  "safety": {
    "localOnly": true,
    "rawPromptIncluded": false,
