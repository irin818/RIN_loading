    "focused-tilt": {
      "description": "Slow focus tilt with green glow.",
      "cssClass": "motion-thinking"
    },
    "speech-pulse": {
      "description": "Rhythmic pulse for speech when no aligned mouth layer exists.",
      "cssClass": "motion-speaking"
    },
    "memory-scan": {
      "description": "Memory scan rings and green pulse.",
      "cssClass": "motion-memory"
    },
    "alert-pulse": {
      "description": "Faster warning pulse.",
      "cssClass": "motion-warning"
    },
    "error-shake": {
      "description": "Short restrained shake for error state.",
      "cssClass": "motion-error"
    },
    "sleep-breath": {
      "description": "Dim slow breathing.",
      "cssClass": "motion-sleeping"
    },
    "attentive-hover": {
      "description": "Attentive listening hover.",
      "cssClass": "motion-listening"
    },
    "review-scan": {
      "description": "Review scan and focus movement.",
      "cssClass": "motion-reviewing"
